# Salin file ini menjadi .env untuk development lokal (netlify dev)
# JANGAN commit file .env yang sudah berisi key asli ke GitHub.

# Wajib: API key dari platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional: model yang dipakai. Default: gpt-4o-mini (murah & cukup akurat untuk klasifikasi)
OPENAI_MODEL=gpt-4o-mini

# Opsional: jika kamu punya akun DataForSEO untuk data volume pencarian ASLI (bukan estimasi AI)
# Kosongkan jika belum punya - tool tetap jalan pakai estimasi dari AI.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
