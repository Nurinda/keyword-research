# Salin file ini menjadi .env untuk development lokal (netlify dev)
# JANGAN commit file .env yang sudah berisi key asli ke GitHub.

# Wajib: API key dari platform.openai.com
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsional: model yang dipakai. Default: gpt-4o-mini (murah & cukup akurat untuk klasifikasi)
OPENAI_MODEL=gpt-4o-mini

# Opsional: jika kamu punya akun DataForSEO untuk data volume pencarian ASLI (bukan estimasi AI)
# Kosongkan jika belum punya - tool tetap jalan pakai estimasi dari AI.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- Tab "Google Trends" & tab "Cek AI Citation" ---

# Wajib untuk tab Google Trends, dan untuk cek "Google AI Overview" di tab Cek AI Citation.
# Daftar di https://serpapi.com/users/sign_up
SERPAPI_KEY=

# Opsional. Untuk cek "Perplexity" di tab Cek AI Citation.
# Daftar di https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Opsional. Model yang dipakai untuk cek "ChatGPT" di tab Cek AI Citation.
# Default: gpt-4o-mini (cepat & murah, cukup untuk tugas ini). Pakai OPENAI_API_KEY yang sama di atas.
OPENAI_MODEL_CHATGPT_CHECK=gpt-4o-mini
